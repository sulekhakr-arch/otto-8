# Copy to .env and fill in (Docker Compose loads .env automatically)
#
#   cp env.example .env

# Required for Parlant / OpenAI
OPENAI_API_KEY=sk-your-key-here

# Streamlit: image upload uses the same key (gpt-4o-mini vision) to describe screenshots for the bot.

# Optional: MongoDB (compose defaults to bundled mongo://mongo:27017)
# MONGODB_URI=mongodb://mongo:27017

# Optional: Composio tools (server.py)
# COMPOSIO_API_KEY=

# Optional: Heyo HTTP tools from the PDF are NOT committed (secrets). Wire separately if needed:
# HEYO_ACCOUNT_DETAIL_URL=https://example.invalid/apis/heyo-bot-get-account-detail
# HEYO_ACCOUNT_DETAIL_TOKEN=
